{
  "name": "agent-flow-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AgentFlow 执行面客户端：在本地工作区执行工作流节点。",
  "bin": {
    "agent-flow-client": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run docs:check && bun run quality:gate",
    "docs:index": "bun run scripts/scenario-index.ts",
    "docs:check": "bun run scripts/scenario-index.ts --check",
    "quality:report": "bun run scripts/quality-report.ts",
    "quality:gate": "bun run scripts/quality-report.ts --gate"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
