# 复制为 .env（已被 .gitignore 忽略），只在本机开发使用；不要提交真实密钥。
HUNDSUN_PUBLIC_API_KEY=
# DSH 入口：可以是 shell 启动器，也可以是 apps/cli/lib/bin.js
DSH_BIN=
# DSH 入口是 .js 时用哪个 node 启动
AF_NODE_BIN=node
# S0 本地验收模型（provider 固定 hundsun-public）
AF_MODEL=hs-deepseek-flash-latest
AF_LLM_BASE_URL=http://47.93.127.129:10088/v1
# 可选：把指定 .credentials.yaml 复制到实例 DSH_HOME（0600）
DSH_CREDENTIALS_SOURCE=
# 开发期自报身份（调度器 EXECUTOR_AUTH=off 时按 X-Client-Id 自动登记节点）；留空用本机 hostname
AF_CLIENT_ID=
